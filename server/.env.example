# 本地开发环境变量模板（复制为 .env）
# 完整变量表见 DEPLOYMENT.md 的「完整环境变量」一节。

NODE_ENV=development
PORT=3000
# 反向代理跳数：Fly.io 为 1；本地直连保持默认 1 即可
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://postgres:password@localhost:5432/nogi_relay
ADMIN_TOKEN=replace-with-a-different-admin-token
CLIENT_TOKEN=replace-with-a-different-client-token

# Firebase：生产使用 FIREBASE_PRIVATE_KEY_BASE64 或 FIREBASE_PRIVATE_KEY_JSON，
# 本地开发可用服务账号 JSON 文件路径。
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_PATH=./firebase-admin-key.json

# Relay 对外地址（用于生成媒体和测试音频 URL）
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_MEDIA_BASE_URL=http://localhost:8081

# 媒体归档
MEDIA_STORAGE_DIR=./nogi-media
MEDIA_MAX_BYTES=104857600
NOGI_MEDIA_PORT=8081

# 乃木坂46 官网
NOGI_WEB_URL=https://message.nogizaka46.com
NOGI_API_URL=https://api.message.nogizaka46.com
NOGI_APP_ID=jp.co.sonymusic.communication.nogizaka 2.5
NOGI_APP_PLATFORM=web
NOGI_ORGANIZATION_ID=1
NOGI_GROUP_IDS=
NOGI_ACCEPT_LANGUAGE=zh-CN,en-US,ja
NOGI_POLL_INTERVAL_SECONDS=60
NOGI_BACKFILL_ON_START=true
NOGI_BLOG_POLL_INTERVAL_SECONDS=60
NOGI_BLOG_PAGE_SIZE=5

# 会话与凭据
NOGI_BROWSER_STATE_FILE=./nogi-browser-state.json
NOGI_ACCESS_TOKEN_STATE_FILE=./nogi-access-token.json
NOGI_BROWSER_REQUEST_TIMEOUT_SECONDS=30
NOGI_MAX_TOKEN_REFRESH_FAILURES=3
# Windows 本地可用 Microsoft Edge
# NOGI_BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# 日志
LOG_STORAGE_DIR=./logs
LOG_MAX_FILE_BYTES=26214400
LOG_RETENTION_DAYS=30

# PostgreSQL 重试与连接池
DB_RETRY_ATTEMPTS=5
DB_RETRY_BASE_DELAY_MS=1000
DB_RETRY_MAX_DELAY_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000
# 空闲连接保底数量：保持为 0 可让空闲连接及时回收，避免被上游约 30 分钟的空闲超时强制断开
DB_POOL_MIN=0
DB_POOL_MAX=20
# 空闲连接回收时间（毫秒）
DB_POOL_IDLE_TIMEOUT_MS=30000
# 连接最长存活秒数（0 表示关闭）；默认 1200 秒，早于上游约 30 分钟的空闲回收
DB_POOL_MAX_LIFETIME_SECONDS=1200
# 预期内的空闲断连在控制台的汇总间隔（毫秒），不会写入审计日志
DB_IDLE_CLIENT_LOG_INTERVAL_MS=3600000
