# fly.toml.example
# Fly.io 应用生产配置模板
# 使用方法：复制本文件为 fly.toml，并将 your-app-name 替换为你在 Fly.io 自定义的应用名称：
#   cp fly.toml.example fly.toml

# 你的 Fly.io 应用名称
app = "your-app-name"
primary_region = "nrt"  # Tokyo, Japan (距离日本官网延迟最低)

[build]
  dockerfile = "Dockerfile"

[env]
  NODE_ENV = "production"
  LOG_STORAGE_DIR = "/data/nogi-logs"
  LOG_MAX_FILE_BYTES = "26214400"
  LOG_RETENTION_DAYS = "30"
  DB_RETRY_ATTEMPTS = "6"
  DB_RETRY_BASE_DELAY_MS = "1000"
  DB_RETRY_MAX_DELAY_MS = "15000"
  DB_CONNECTION_TIMEOUT_MS = "10000"
  DB_POOL_MIN = "1"
  DB_POOL_MAX = "20"
  PORT = "8080"
  NOGI_WEB_URL = "https://message.nogizaka46.com"
  NOGI_API_URL = "https://api.message.nogizaka46.com"
  NOGI_APP_ID = "jp.co.sonymusic.communication.nogizaka 2.5"
  NOGI_APP_PLATFORM = "web"
  NOGI_ORGANIZATION_ID = "1"
  NOGI_POLL_INTERVAL_SECONDS = "60"
  NOGI_BACKFILL_ON_START = "true"
  NOGI_BROWSER_STATE_FILE = "/data/nogi-browser-state.json"
  NOGI_ACCESS_TOKEN_STATE_FILE = "/data/nogi-access-token.json"
  NOGI_BROWSER_HEADLESS = "true"
  NOGI_BROWSER_AUTH_WAIT_SECONDS = "30"
  NOGI_BROWSER_SETTLE_SECONDS = "8"
  NOGI_BROWSER_STORAGE_STATE_TIMEOUT_SECONDS = "10"
  NOGI_BROWSER_REQUEST_TIMEOUT_SECONDS = "30"
  NOGI_BROWSER_BLOCK_MEDIA = "true"
  NOGI_MAX_TOKEN_REFRESH_FAILURES = "3"
  NOGI_MACHINE_MEMORY_RESTART_MB = "700"
  # 0 = 关闭定时重启，仅保留 Linux cgroup 整机内存阈值重启
  NOGI_BROWSER_RESTART_INTERVAL_SECONDS = "0"
  NOGI_MEDIA_PORT = "8081"
  MEDIA_STORAGE_DIR = "/data/nogi-media"
  MEDIA_MAX_BYTES = "104857600"
  # 域名跟随你的应用名自动对应
  PUBLIC_BASE_URL = "https://your-app-name.fly.dev"
  PUBLIC_MEDIA_BASE_URL = "https://your-app-name.fly.dev:8081"

[[vm]]
  memory = '1gb'
  cpu_kind = 'shared'
  cpus = 1

[[mounts]]
  source = "nogi_media"
  destination = "/data"
  initial_size = "3gb"

# 主 API 服务 (端口 80/443 映射到内部 8080)
[[services]]
  protocol = "tcp"
  internal_port = 8080

  [[services.ports]]
    port = 80
    handlers = ["http"]
    force_https = true

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [services.concurrency]
    type = "connections"
    hard_limit = 25
    soft_limit = 20

  [[services.tcp_checks]]
    interval = "15s"
    timeout = "20s"
    grace_period = "30s"

  [[services.http_checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
    method = "get"
    path = "/health"
    protocol = "http"

# 媒体服务 (端口 8081)
[[services]]
  protocol = "tcp"
  internal_port = 8081

  [[services.ports]]
    port = 8081
    handlers = ["tls", "http"]

  [services.concurrency]
    type = "connections"
    hard_limit = 25
    soft_limit = 20

  [[services.tcp_checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
    port = 8081
