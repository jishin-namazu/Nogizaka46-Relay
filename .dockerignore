# Ignore everything by default to avoid scanning massive files in the repository root
*

# Allow Dockerfile and server directory
!Dockerfile
!server/
!server/**

# Exclude sensitive files and local artifacts inside server
server/node_modules/
server/logs/
server/*.log
server/.env
server/.env.*
**/firebase-admin-key.json
**/nogi-access-token.json
**/nogi-browser-state.json
**/nogi-browser-state.json.tmp-*
